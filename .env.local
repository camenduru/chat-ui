PUBLIC_ORIGIN=https://chat.tost.ai
PUBLIC_APP_NAME="Tost Chat"
PUBLIC_APP_ASSETS=tostchat
PUBLIC_APP_COLOR=Yellow
PUBLIC_APP_DESCRIPTION="Tost Chat is a non-profit, open-source service that serves inference for the latest AI chat models. Sponsored by RunPod ❤"
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=chat-ui
PUBLIC_ANNOUNCEMENT_BANNERS=`[]`
OPENAI_API_KEY=EMPTY
WEBHOOK_URL_REPORT_ASSISTANT=false
ALLOW_INSECURE_COOKIES=false
COOKIE_NAME=tost-chat
COOKIE_SAMESITE=strict
COOKIE_SECURE=true
MODELS=`[
  {
    "name": "Qwen/Qwen2.5-Coder-14B-Instruct",
    "id": "Qwen/Qwen2.5-Coder-14B-Instruct",
    "endpoints": [{
      "type" : "openai",
      "baseURL": "http://127.0.0.1:8000/v1"
    }]
  }
]`